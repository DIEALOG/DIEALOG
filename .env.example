# Service Ports (Host)
BACKEND_PORT=8080
CRYPTO_PORT=8081

# PostgreSQL Databases Host Ports
HOST_BACKEND_DB_PORT=5432
HOST_CRYPTO_DB_PORT=5433

# Application Common
APP_ENV=development
SERVER_ADDRESS=:8080
CONTEXT_TIMEOUT=2

# PostgreSQL Database (Backend)
BACKEND_DB_USER=diealog_backend
BACKEND_DB_PASS=diealog_backend_password
BACKEND_DB_NAME=diealog_backend

# PostgreSQL Database (Crypto - Credential Store)
CRYPTO_DB_USER=diealog_crypto
CRYPTO_DB_PASS=diealog_crypto_password
CRYPTO_DB_NAME=diealog_crypto

# Legacy Fallback (단일 DB 호환용)
# DB_HOST=postgres-backend
# DB_PORT=5432
# DB_USER=diealog_backend
# DB_PASS=diealog_backend_password
# DB_NAME=diealog_backend

# Backend JWT Auth
ACCESS_TOKEN_EXPIRY_HOUR=2
REFRESH_TOKEN_EXPIRY_HOUR=168
ACCESS_TOKEN_SECRET=diealog_access_token_secret_key_change_me
REFRESH_TOKEN_SECRET=diealog_refresh_token_secret_key_change_me

# Crypto Service & KMS
INTERNAL_SECRET_KEY=diealog_internal_secret_key_change_me
KMS_KEY_ARN=
MOCK_KMS_MASTER_KEY=01234567890123456789012345678901 # AES-256 32-byte key
