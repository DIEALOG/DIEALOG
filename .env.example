# Values in this file are only used by Docker Compose itself (port mappings,
# the credentials the postgres containers are created with, and the uid the Go
# services run as). The services themselves read env/backend.env and
# env/crypto.env, which are mounted into the containers as /app/.env.
#
# Copy this file to .env and fill in the blanks. Keep the DB_USER / DB_PASS /
# DB_NAME values here identical to the ones in env/backend.env and
# env/crypto.env, otherwise the services cannot log in to their databases.

# Host user the Go services run as, so they can read the mounted env file.
# Use the output of `id -u` and `id -g` on the deployment host.
APP_UID=1000
APP_GID=1000

# Service Ports (Host)
BACKEND_PORT=8080
CRYPTO_PORT=8081

# PostgreSQL Host Ports (bound to 127.0.0.1 only)
HOST_BACKEND_DB_PORT=5442
HOST_CRYPTO_DB_PORT=5443

# PostgreSQL Database (Backend)
BACKEND_DB_USER=diealog_backend
BACKEND_DB_PASS=
BACKEND_DB_NAME=diealog_backend

# PostgreSQL Database (Crypto - Credential Store)
CRYPTO_DB_USER=diealog_crypto
CRYPTO_DB_PASS=
CRYPTO_DB_NAME=diealog_crypto
