# Mounted into the crypto container as /app/.env.
APP_ENV=production
SERVER_ADDRESS=:8080
CONTEXT_TIMEOUT=30

# Must match postgres-crypto in docker-compose.yml.
DB_HOST=postgres-crypto
DB_PORT=5432
DB_USER=diealog_crypto
DB_PASS=
DB_NAME=diealog_crypto

# Shared with env/backend.env; the crypto service verifies X-Internal-Secret-Key.
INTERNAL_SECRET_KEY=

# Envelope encryption. KMS_KEY_ARN is unused while the mock KMS is in place.
# MOCK_KMS_MASTER_KEY must be exactly 32 characters (AES-256), for example
# the output of `openssl rand -base64 24`.
KMS_KEY_ARN=
MOCK_KMS_MASTER_KEY=
