# Mounted into the backend container as /app/.env.
APP_ENV=production
SERVER_ADDRESS=:8080
CONTEXT_TIMEOUT=30

# Must match postgres-backend in docker-compose.yml.
DB_HOST=postgres-backend
DB_PORT=5432
DB_USER=diealog_backend
DB_PASS=
DB_NAME=diealog_backend

ACCESS_TOKEN_EXPIRY_HOUR=2
REFRESH_TOKEN_EXPIRY_HOUR=168
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Shared with env/crypto.env; the backend sends it as X-Internal-Secret-Key.
INTERNAL_SECRET_KEY=
